{{!
    @template mod_cv/view

    Main template for mod_cv student view.
}}
<div class="mod-cv-container" id="mod_cv_app" data-cmid="{{cmid}}">

    <!-- Header / Banner -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-0">{{activityname}}</h2>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            {{#has_attempt_limit}}
                <span class="badge badge-info bg-info text-white font-weight-bold px-3 py-2" id="cv_attempts_badge"><i class="fa fa-refresh"></i> {{attempts_count_text}}</span>
            {{/has_attempt_limit}}
            {{#domain_title}}
                <span class="badge badge-secondary bg-secondary px-3 py-2 text-white font-weight-bold"><i class="fa fa-th-large"></i> {{domain_title}}</span>
            {{/domain_title}}
            <span class="cv-badge-exam"><i class="fa fa-certificate"></i> {{exam_title}}</span>
        </div>
    </div>

    {{#intro}}
        <div class="alert alert-info mb-4">
            {{{intro}}}
        </div>
    {{/intro}}

    <form id="cv_input_form">
        {{#show_candidate_info}}
        <!-- Card 1: Candidate Information -->
        <div class="cv-card" id="card_candidate_info">
            <div class="cv-card-header">
                <h4><i class="fa fa-user text-primary"></i> {{personal_title}}</h4>
            </div>
            <div class="cv-card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="candidate_name" class="form-label font-weight-bold">{{#str}}candidate_name, mod_cv{{/str}} *</label>
                        <input type="text" class="form-control" id="candidate_name" name="name" value="{{candidate.name}}" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="candidate_email" class="form-label font-weight-bold">{{#str}}candidate_email, mod_cv{{/str}} *</label>
                        <input type="email" class="form-control" id="candidate_email" name="email" value="{{candidate.email}}" required>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="candidate_phone" class="form-label font-weight-bold">{{#str}}candidate_phone, mod_cv{{/str}}</label>
                        <input type="text" class="form-control" id="candidate_phone" name="phone" value="{{candidate.phone}}">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="candidate_country" class="form-label font-weight-bold">{{#str}}candidate_country, mod_cv{{/str}}</label>
                        <input type="text" class="form-control" id="candidate_country" name="country" value="{{candidate.country}}">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="degree_level" class="form-label font-weight-bold">{{#str}}degree_level, mod_cv{{/str}} *</label>
                        <select class="form-select custom-select" id="degree_level" name="degree">
                            <option value="bachelors" {{#degree_is_bachelors}}selected{{/degree_is_bachelors}}>{{#str}}degree_bachelors, mod_cv{{/str}}</option>
                            <option value="secondary" {{#degree_is_secondary}}selected{{/degree_is_secondary}}>{{#str}}degree_secondary, mod_cv{{/str}}</option>
                            <option value="postgrad" {{#degree_is_postgrad}}selected{{/degree_is_postgrad}}>{{#str}}degree_postgrad, mod_cv{{/str}}</option>
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="degree_institution" class="form-label font-weight-bold">{{#str}}degree_institution, mod_cv{{/str}} *</label>
                        <input type="text" class="form-control" id="degree_institution" name="institution" value="{{candidate.institution}}" required placeholder="{{#str}}degree_institution_placeholder, mod_cv{{/str}}">
                    </div>
                    <div class="col-md-3 mb-3">
                        <label for="degree_startdate" class="form-label font-weight-bold">{{#str}}degree_startdate, mod_cv{{/str}} *</label>
                        <input type="date" class="form-control" id="degree_startdate" name="degree_startdate" value="{{candidate.degree_startdate}}" required>
                        <small class="form-text text-muted">Day, Month, Year</small>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label for="degree_enddate" class="form-label font-weight-bold">{{#str}}degree_enddate, mod_cv{{/str}} *</label>
                        <input type="date" class="form-control" id="degree_enddate" name="degree_enddate" value="{{candidate.degree_enddate}}" required>
                        <small class="form-text text-muted">Graduation Date</small>
                    </div>
                </div>
            </div>
        </div>
        {{/show_candidate_info}}

        {{#show_course_education}}
        <!-- Card 2: Course & Education Verification (Course-Aware) -->
        <div class="cv-card" id="card_course_education">
            <div class="cv-card-header">
                <h4><i class="fa fa-graduation-cap text-primary"></i> {{course_title}}</h4>
            </div>
            <div class="cv-card-body">
                <div class="row mb-3">
                    <div class="col-md-12">
                        <label for="course_selector" class="form-label font-weight-bold">{{#str}}select_course, mod_cv{{/str}} *</label>
                        <select class="form-select custom-select" id="course_selector" name="course_id">
                            {{#courses_list}}
                                <option value="{{id}}" data-fullname="{{fullname}}" data-startdate="{{startdate}}" data-enddate="{{enddate}}" {{#is_selected}}selected{{/is_selected}}>{{displayname}}</option>
                            {{/courses_list}}
                        </select>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="course_startdate" class="form-label font-weight-bold">{{#str}}course_startdate, mod_cv{{/str}} *</label>
                        <input type="date" class="form-control" id="course_startdate" name="course_startdate" value="{{course_startdate}}" required>
                        <small class="form-text text-muted">Day, Month, Year</small>
                    </div>
                    <div class="col-md-6">
                        <label for="course_enddate" class="form-label font-weight-bold">{{#str}}course_enddate, mod_cv{{/str}} *</label>
                        <input type="date" class="form-control" id="course_enddate" name="course_enddate" value="{{course_enddate}}" required>
                        <small class="form-text text-muted">Course Completion / End Date</small>
                    </div>
                </div>
                <div class="cv-info-grid mt-2">
                    {{#domain_title}}
                    <div class="cv-info-item">
                        <label>{{#str}}field_type, mod_cv{{/str}}</label>
                        <span>{{domain_title}}</span>
                    </div>
                    {{/domain_title}}
                    <div class="cv-info-item">
                        <label>{{#str}}exam_type, mod_cv{{/str}}</label>
                        <span>{{exam_title}}</span>
                    </div>
                    <div class="cv-info-item">
                        <label>{{#str}}course_contact_hours, mod_cv{{/str}}</label>
                        <span>{{contact_hours}} Hours</span>
                    </div>
                    <div class="cv-info-item">
                        <label>{{#str}}course_provider, mod_cv{{/str}}</label>
                        <span>{{provider_name}}</span>
                    </div>
                </div>
            </div>
        </div>
        {{/show_course_education}}

        <!-- Card 3: Project Experience -->
        <div class="cv-card">
            <div class="cv-card-header">
                <h4><i class="fa fa-briefcase text-primary"></i> {{projects_title}}</h4>
                <button type="button" class="btn btn-outline-primary btn-sm" id="btn_add_project">
                    <i class="fa fa-plus"></i> {{#str}}btn_add_project, mod_cv{{/str}}
                </button>
            </div>
            <div class="cv-card-body">
                <p class="text-muted">{{#str}}step_projects_desc, mod_cv{{/str}}</p>

                <div id="projects_container">
                    <!-- Project cards will be injected dynamically or rendered from pre-saved projects -->
                </div>

                <div class="text-center mt-3">
                    <button type="button" class="btn btn-outline-primary" id="btn_add_project_bottom">
                        <i class="fa fa-plus"></i> {{#str}}btn_add_project, mod_cv{{/str}}
                    </button>
                </div>
            </div>
        </div>

        <!-- Card 4: Actions & AI Generation -->
        <div class="cv-card">
            <div class="cv-card-body text-center py-4">
                <div id="cv_loading_indicator" class="cv-loading-overlay mb-3">
                    <div class="spinner-border text-primary" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <p class="mt-2 font-weight-bold text-primary">{{#str}}generating_message, mod_cv{{/str}}</p>
                </div>

                <div id="cv_info_alert" class="alert alert-info d-none text-left" role="alert"></div>
                <div id="cv_error_alert" class="alert alert-danger d-none text-left" role="alert"></div>
                {{#attempts_exhausted}}
                    <div id="cv_exhausted_alert" class="alert alert-warning text-left" role="alert">
                        <i class="fa fa-exclamation-triangle"></i> {{attempts_exhausted_text}}
                    </div>
                {{/attempts_exhausted}}
                {{^attempts_exhausted}}
                    <div id="cv_exhausted_alert" class="alert alert-warning text-left d-none" role="alert"></div>
                    {{#has_attempt_limit}}
                        <p id="cv_attempts_notice" class="text-muted small mb-3">
                            <i class="fa fa-info-circle"></i> {{attempts_remaining_text}}
                        </p>
                    {{/has_attempt_limit}}
                {{/attempts_exhausted}}

                <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">
                    <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm" id="btn_submit_ai" {{#attempts_exhausted}}disabled{{/attempts_exhausted}}>
                        <i class="fa fa-magic"></i> {{#str}}btn_generate_ai, mod_cv{{/str}}
                    </button>
                    {{^show_review}}
                    <button type="button" class="btn btn-outline-primary btn-lg px-4 shadow-sm {{^has_output}}d-none{{/has_output}}" id="btn_open_output_modal_direct">
                        <i class="fa fa-window-maximize"></i> {{#str}}btn_view_output_window, mod_cv{{/str}}
                    </button>
                    {{/show_review}}
                </div>
            </div>
        </div>
    </form>

    <!-- Card 5: Output & Review Window -->
    <div id="cv_review_section" class="cv-card {{^has_output}}d-none{{/has_output}}">
        <div class="cv-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h4 class="mb-0"><i class="fa fa-check-circle text-success"></i> {{#str}}preview_heading, mod_cv{{/str}}</h4>
            <div class="cv-output-header-actions d-flex align-items-center gap-2">
                <button type="button" class="btn btn-primary btn-sm cv-copy-btn" id="btn_copy_all_output" data-copy-target="#cv_output_display">
                    <i class="fa fa-clipboard"></i> {{#str}}btn_copy_all, mod_cv{{/str}}
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btn_open_output_modal">
                    <i class="fa fa-expand"></i> {{#str}}btn_modal_window, mod_cv{{/str}}
                </button>
                <a href="{{export_url}}" class="btn btn-outline-success btn-sm" id="btn_export_pdf" target="_blank">
                    <i class="fa fa-download"></i> {{#str}}btn_download_pdf, mod_cv{{/str}}
                </a>
            </div>
        </div>
        <div class="cv-card-body">
            <div id="cv_output_display">
                <!-- Rendered output -->
            </div>
        </div>
    </div>

    <!-- Modal: AI Output Window Popup -->
    <div class="modal fade" id="cvOutputModal" tabindex="-1" role="dialog" aria-labelledby="cvOutputModalLabel" aria-hidden="true" style="display: none;">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header d-flex justify-content-between align-items-center">
                    <h5 class="modal-title font-weight-bold" id="cvOutputModalLabel">
                        <i class="fa fa-id-card text-primary"></i> {{#str}}modal_output_title, mod_cv{{/str}}
                    </h5>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-primary btn-sm cv-copy-btn" id="btn_copy_modal_output" data-copy-target="#cv_modal_output_display">
                            <i class="fa fa-clipboard"></i> {{#str}}btn_copy_all, mod_cv{{/str}}
                        </button>
                        <button type="button" class="btn-close close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="{{#str}}closebuttontitle{{/str}}">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body">
                    <div id="cv_modal_output_display">
                        <!-- Cloned or rendered output -->
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between flex-wrap gap-2">
                    <a href="{{export_url}}" class="btn btn-outline-success" id="btn_modal_export_pdf" target="_blank">
                        <i class="fa fa-download"></i> {{#str}}btn_download_pdf, mod_cv{{/str}}
                    </a>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-dismiss="modal">
                            {{#str}}closebuttontitle{{/str}}
                        </button>
                        <button type="button" class="btn btn-primary cv-copy-btn" data-copy-target="#cv_modal_output_display">
                            <i class="fa fa-clipboard"></i> {{#str}}btn_copy_all, mod_cv{{/str}}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Pass initial data to JavaScript -->
<script type="application/json" id="mod_cv_initial_data">
    {{{initial_data_json}}}
</script>
